PORT=5050
MONGO_URI=mongodb://localhost:27017/homestay_manager
JWT_SECRET=super_secret_change_me
NODE_ENV=development
CLIENT_URL=http://localhost:5175
CLIENT_URLS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Public base URL for locally uploaded images (no trailing slash)
API_PUBLIC_URL=http://localhost:5050
# Card payments: sk_test_... / sk_live_... (no spaces). Restart API after editing.
STRIPE_SECRET_KEY=
# Required for Stripe Elements on the booking page (pk_test_... / pk_live_...).
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Set true in production to block test keys and require sk_live_/pk_live_.
STRIPE_LIVE_MODE_REQUIRED=false
# Set false for real payments (recommended). Dev fallback simulates success without charging card.
ENABLE_DEV_CARD_FALLBACK=true
STRIPE_CURRENCY=usd
# MoMo e-wallet payment (test endpoint by default)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5174/dashboard?payment=success
MOMO_IPN_URL=http://localhost:5050/api/bookings/webhook/momo
# Dynamic VietQR image config (bank short code or BIN supported by img.vietqr.io)
VIETQR_BANK_ID=
VIETQR_TEMPLATE=compact2
# If booking prices are stored in USD, keep USD and set conversion rate.
# If your booking prices are already in VND, set BANK_TRANSFER_BASE_CURRENCY=VND.
BANK_TRANSFER_BASE_CURRENCY=USD
USD_TO_VND_RATE=25500
# Internal bot token for matching transfer notifications -> booking status
BOT_SYNC_TOKEN=
# Bank transfer (display to user when paymentMethod=bank_transfer)
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_BRANCH=
BANK_SWIFT=
# Optional note shown on payment screen (e.g. transfer content format)
BANK_TRANSFER_INSTRUCTIONS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@homestay.local
# AI chat: Cohere (if set, used first). Key from https://dashboard.cohere.com/
COHERE_API_KEY=
# e.g. command-r-08-2024, command-a-03-2025
COHERE_MODEL=command-r-08-2024
# Google Gemini (used if COHERE_API_KEY is empty). Key usually starts with AIza...
GEMINI_API_KEY=
# e.g. gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash
# OpenAI (used if neither Cohere nor Gemini key is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: email polling bot (Node/Python) to read transfer emails
BOT_IMAP_HOST=imap.gmail.com
BOT_IMAP_PORT=993
BOT_EMAIL_USER=
BOT_EMAIL_PASS=
BOT_EMAIL_FROM_FILTER=service@momo.vn
BOT_MAX_FETCH_PER_RUN=20
BOT_RECENT_DAYS=7
BOT_POLL_SECONDS=30
BOT_FALLBACK_LOOKBACK_HOURS=48
