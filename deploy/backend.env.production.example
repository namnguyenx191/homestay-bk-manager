NODE_ENV=production
PORT=5000

# Replace with Mongo Atlas URI or your VPS Mongo URI
MONGO_URI=mongodb://127.0.0.1:27017/homestay_manager
JWT_SECRET=replace-with-strong-secret

# Your public frontend domain
CLIENT_URL=https://your-domain.com
CLIENT_URLS=https://your-domain.com
# Optional: other frontends allowed to call the API (Vercel preview URLs, www, etc.)
EXTRA_CORS_ORIGINS=

# Public API URL for uploaded file links
API_PUBLIC_URL=https://your-domain.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_MODE_REQUIRED=true
ENABLE_DEV_CARD_FALLBACK=false
STRIPE_CURRENCY=usd

# MoMo
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=https://your-domain.com/dashboard?payment=success
MOMO_IPN_URL=https://your-domain.com/api/bookings/webhook/momo

# VietQR / Bank transfer
VIETQR_BANK_ID=
VIETQR_TEMPLATE=compact2
BANK_TRANSFER_BASE_CURRENCY=USD
USD_TO_VND_RATE=25500
BOT_SYNC_TOKEN=
BOT_AUTO_SYNC=true
BOT_API_BASE=https://your-api-domain.com/api
BOT_IMAP_HOST=imap.gmail.com
BOT_IMAP_PORT=993
BOT_EMAIL_USER=
BOT_EMAIL_PASS=
BOT_EMAIL_FROM_FILTER=momo,mbbank,mb bank,vietqr,service@momo.vn
BOT_MAX_FETCH_PER_RUN=20
BOT_RECENT_DAYS=7
BOT_POLL_SECONDS=30
BOT_FALLBACK_LOOKBACK_HOURS=48
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_NAME=
BANK_BRANCH=
BANK_SWIFT=
BANK_TRANSFER_INSTRUCTIONS=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis + SMTP (required if you use queue email worker)
REDIS_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@your-domain.com

# Optional AI keys
COHERE_API_KEY=
COHERE_MODEL=command-r-08-2024
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
